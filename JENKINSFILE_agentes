pipeline {
    agent any
    stages {

        stage('Get Code') {
       
            steps {
               echo '---- LIMPIEZA----'
               cleanWs()
               git branch: 'master',
               url: 'https://github.com/Anripasper/todo-list-aws.git',
               credentialsId: 'GitTOKEN'
               stash name: 'code', includes:'**'
             

                }
            }
    stage('Set Environment') {
        
    steps {
         unstash name: 'code'
        sh '''
            echo "==== CREATING VENV ===="
            python3 -m venv venv

            . venv/bin/activate
             echo "==== INSTALACIONES ===="
            pip install --upgrade pip
           echo "==== who am i===="
                    whoami
                    hostname
        '''
    }
}

        stage('Deploy') {
             
            steps {
                 unstash name: 'code'
                sh '''
                    aws sts get-caller-identity
                    sam build
                    sam validate --region us-east-1
                   sam deploy --config-env production \
                --stack-name production-todo-list-aws \
                --region us-east-1 \
                --resolve-s3 \
                --capabilities CAPABILITY_IAM \
                --no-disable-rollback \
                --parameter-overrides Stage="production" \
                --save-params \
                --no-confirm-changeset \
                --no-fail-on-empty-changeset \
                
                  aws cloudformation describe-stacks \
                    --stack-name production-todo-list-aws \
                    --region us-east-1 \
                    --query "Stacks[0].Outputs[?OutputKey=='BaseUrlApi'].OutputValue" \
                    --output text > BASEURL.txt
                    
                     echo "==== who am i===="
                    whoami
                    hostname
                     cat BASEURL.txt
                '''
                
                   script {
                    env.BASE_URL_API = readFile('BASEURL.txt').trim()
                    echo "Base URL : ${env.BASE_URL_API}"
                }
                   stash name: 'baseurl', includes: 'BASEURL.txt'
                
            }
        }
          
 
        
        stage('Rest Test') {
        agent { label 'agente2' }
           
            steps {
                 unstash name: 'code'
                 unstash name: 'baseurl'
                    script {
                  def baseUrl = readFile('BASEURL.txt').trim()
                  echo "Base URL: ${baseUrl}"
                  env.BASE_URL = baseUrl
                sh'''
                   python3 -m venv venv
                   . venv/bin/activate
                    pip install pytest requests
                 # //export BASE_URL="${baseUrl}"
                 #  // export BASE_URL=$(aws cloudformation describe-stacks --stack-name production-todo-list-aws --query 'Stacks[0].Outputs[?OutputKey==`BaseUrlApi`].OutputValue' --region us-east-1 --output text)
                   echo $BASE_URL
                  
                   echo "Ejecutando pruebas"
                   pytest --junitxml=result-rest.xml test/integration/todoApiTest.py -k 'test_api_listtodos or test_api_gettodo'
                    
                    echo "==== who am i===="
                    whoami
                    hostname
                  '''
                    }
                   junit 'result-rest.xml'
                  
              
            }
        }
 

        
    }}
